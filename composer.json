{
  "name": "craftcms/aws-s3",
  "description": "Amazon Rekognition focal points and CloudFront invalidation for Craft CMS assets on Amazon S3 disks",
  "type": "craft-plugin",
  "keywords": [
    "aws",
    "cloudfront",
    "cms",
    "craftcms",
    "laravel",
    "rekognition",
    "s3"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pixel & Tonic",
      "homepage": "https://pixelandtonic.com/"
    }
  ],
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/aws-s3/issues?state=open",
    "source": "https://github.com/craftcms/aws-s3",
    "docs": "https://github.com/craftcms/aws-s3/blob/3.x/README.md",
    "rss": "https://github.com/craftcms/aws-s3/commits/3.x.atom"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0-alpha.21",
    "aws/aws-sdk-php": "^3.300",
    "league/flysystem-aws-s3-v3": "^3.32.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.13",
    "laravel/pint": "^1.22",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\AwsS3\\": "src/"
    }
  },
  "scripts": {
    "check-cs": "pint --test",
    "fix-cs": "pint",
    "phpstan": "phpstan --memory-limit=1G",
    "test": "pest"
  },
  "extra": {
    "class": "CraftCms\\AwsS3\\Plugin",
    "name": "Amazon S3",
    "handle": "aws-s3",
    "description": "Amazon Rekognition focal points and CloudFront invalidation for assets on Amazon S3",
    "documentationUrl": "https://github.com/craftcms/aws-s3/blob/3.x/README.md"
  },
  "config": {
    "platform": {
      "php": "8.5"
    },
    "allow-plugins": {
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\AwsS3\\Tests\\": "tests/"
    }
  }
}
